generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  bio          String?
  profilePhoto String?
  website      String?
  gender       String?
  dateOfBirth  DateTime?
  isPrivate    Boolean   @default(false)
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  isBlocked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  posts        Post[]
  postLikes    PostLike[]
  postSaves    PostSave[]
  postComments Comment[]
  commentLikes CommentLike[]
  stories      Story[]
  storyViews   StoryView[]
  highlights   StoryHighlight[]
  reels        Reel[]
  reelLikes    ReelLike[]
  reelComments ReelComment[]

  followers          Follow[]        @relation("Followers")
  following          Follow[]        @relation("Following")
  followRequestsSent FollowRequest[] @relation("SentFollowRequests")
  followRequestsRecv FollowRequest[] @relation("ReceivedFollowRequests")

  blockedUsers BlockedUser[] @relation("Blocker")
  blockedBy    BlockedUser[] @relation("Blocked")

  conversations    ConversationMember[]
  messages         Message[]
  messageReads     MessageRead[]
  messageReactions MessageReaction[]

  notificationsSent Notification[] @relation("Actor")
  notificationsRecv Notification[] @relation("Recipient")

  devices     UserDevice[]
  reportsMade Report[]     @relation("Reporter")

  // Profile & Settings
  settings         UserSettings?
  closeFriends     CloseFriend[]       @relation("CloseFriendsOwner")
  closeFriendsOf   CloseFriend[]       @relation("CloseFriendsTarget")
  hiddenStoryUsers HiddenStoryUser[]   @relation("HiddenStoryOwner")
  hiddenStoryBy    HiddenStoryUser[]   @relation("HiddenStoryTarget")
  mutedUsers       MutedUser[]         @relation("Muter")
  mutedBy          MutedUser[]         @relation("Muted")
  restrictedUsers  RestrictedUser[]    @relation("Restricter")
  restrictedBy     RestrictedUser[]    @relation("Restricted")
  hiddenWords      HiddenWord[]
  sessions         UserSession[]
  dataExports      DataExportRequest[]
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id])
  following User @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model FollowRequest {
  id         String   @id @default(uuid()) @db.Uuid
  senderId   String   @db.Uuid
  receiverId String   @db.Uuid
  createdAt  DateTime @default(now())

  sender   User @relation("SentFollowRequests", fields: [senderId], references: [id])
  receiver User @relation("ReceivedFollowRequests", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}

model BlockedUser {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model Post {
  id        String    @id @default(uuid()) @db.Uuid
  authorId  String    @db.Uuid
  caption   String?
  location  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author   User          @relation(fields: [authorId], references: [id])
  media    PostMedia[]
  likes    PostLike[]
  saves    PostSave[]
  comments Comment[]
  hashtags PostHashtag[]
}

model PostMedia {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  url       String
  mimeType  String
  size      Int?
  width     Int?
  height    Int?
  duration  Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model PostSave {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Comment {
  id              String   @id @default(uuid()) @db.Uuid
  postId          String   @db.Uuid
  userId          String   @db.Uuid
  parentCommentId String?  @db.Uuid
  text            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])
  parentComment Comment?      @relation("Replies", fields: [parentCommentId], references: [id])
  replies       Comment[]     @relation("Replies")
  likes         CommentLike[]
}

model CommentLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  commentId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model Hashtag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  posts PostHashtag[]
}

model PostHashtag {
  id        String @id @default(uuid()) @db.Uuid
  postId    String @db.Uuid
  hashtagId String @db.Uuid

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
}

model Story {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  mediaUrl  String
  mediaType String
  caption   String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user           User                 @relation(fields: [userId], references: [id])
  views          StoryView[]
  highlightItems StoryHighlightItem[]
}

model StoryView {
  id       String   @id @default(uuid()) @db.Uuid
  storyId  String   @db.Uuid
  viewerId String   @db.Uuid
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id])

  @@unique([storyId, viewerId])
}

model StoryHighlight {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  coverUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                 @relation(fields: [userId], references: [id])
  items StoryHighlightItem[]
}

model StoryHighlightItem {
  id          String   @id @default(uuid()) @db.Uuid
  highlightId String   @db.Uuid
  storyId     String   @db.Uuid
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  highlight StoryHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  story     Story          @relation(fields: [storyId], references: [id])
}

model Reel {
  id           String   @id @default(uuid()) @db.Uuid
  authorId     String   @db.Uuid
  caption      String?
  mediaUrl     String
  thumbnailUrl String?
  duration     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  likes    ReelLike[]
  comments ReelComment[]
}

model ReelLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  reelId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
}

model ReelComment {
  id        String   @id @default(uuid()) @db.Uuid
  reelId    String   @db.Uuid
  userId    String   @db.Uuid
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  isGroup   Boolean  @default(false)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  type           String    @default("TEXT") // TEXT, IMAGE, VIDEO, POST_SHARE
  text           String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id])
  attachments  MessageAttachment[]
  reads        MessageRead[]
  reactions    MessageReaction[]
}

model MessageAttachment {
  id        String @id @default(uuid()) @db.Uuid
  messageId String @db.Uuid
  url       String
  mimeType  String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageRead {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  reaction  String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  recipientId String   @db.Uuid
  actorId     String?  @db.Uuid
  type        String // FOLLOW, POST_LIKE, etc.
  entityId    String? // The ID of the post/comment/etc
  message     String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User  @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("Actor", fields: [actorId], references: [id])
}

model UserDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  deviceToken String
  platform    String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id         String   @id @default(uuid()) @db.Uuid
  reporterId String   @db.Uuid
  entityType String // USER, POST, COMMENT, etc.
  entityId   String
  reason     String
  status     String   @default("PENDING") // PENDING, RESOLVED, REJECTED
  createdAt  DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id])
}

model UserSettings {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  // Privacy
  isPrivate Boolean @default(false)

  // Story Privacy
  storyPrivacy String @default("EVERYONE") // EVERYONE, FOLLOWERS, CLOSE_FRIENDS

  // Comments
  allowComments String @default("EVERYONE") // EVERYONE, FOLLOWERS, PEOPLE_YOU_FOLLOW, OFF

  // Mentions & Tags
  allowMentions     String  @default("EVERYONE") // EVERYONE, PEOPLE_YOU_FOLLOW, NO_ONE
  allowTags         String  @default("EVERYONE")
  manualTagApproval Boolean @default(false)

  // Messages
  messagePrivacy String @default("EVERYONE") // EVERYONE, FOLLOWERS, PEOPLE_YOU_FOLLOW, NO_ONE

  // Notifications
  notifyLikes        Boolean @default(true)
  notifyComments     Boolean @default(true)
  notifyNewFollowers Boolean @default(true)
  notifyMessages     Boolean @default(true)
  notifyStoryReplies Boolean @default(true)
  notifyMentions     Boolean @default(true)

  // Email Notifications
  emailSecurity Boolean @default(true)
  emailProduct  Boolean @default(true)

  // Activity & Read Receipts
  showActivityStatus Boolean @default(true)
  showReadReceipts   Boolean @default(true)

  // Preferences
  language       String  @default("en")
  mediaQuality   String  @default("auto")
  autoplayVideos Boolean @default(true)
  dataSaver      Boolean @default(false)

  // Security
  twoFactorEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CloseFriend {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  friendId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User @relation("CloseFriendsOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("CloseFriendsTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model HiddenStoryUser {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  hiddenUserId String   @db.Uuid
  createdAt    DateTime @default(now())

  user       User @relation("HiddenStoryOwner", fields: [userId], references: [id], onDelete: Cascade)
  hiddenUser User @relation("HiddenStoryTarget", fields: [hiddenUserId], references: [id], onDelete: Cascade)

  @@unique([userId, hiddenUserId])
}

model MutedUser {
  id           String   @id @default(uuid()) @db.Uuid
  muterId      String   @db.Uuid
  mutedId      String   @db.Uuid
  mutePosts    Boolean  @default(true)
  muteStories  Boolean  @default(true)
  muteMessages Boolean  @default(false)
  createdAt    DateTime @default(now())

  muter User @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
}

model RestrictedUser {
  id           String   @id @default(uuid()) @db.Uuid
  restricterId String   @db.Uuid
  restrictedId String   @db.Uuid
  createdAt    DateTime @default(now())

  restricter User @relation("Restricter", fields: [restricterId], references: [id], onDelete: Cascade)
  restricted User @relation("Restricted", fields: [restrictedId], references: [id], onDelete: Cascade)

  @@unique([restricterId, restrictedId])
}

model HiddenWord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  word      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
}

model UserSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String
  device     String?
  platform   String?
  browser    String?
  ipAddress  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DataExportRequest {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  status    String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  fileUrl   String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
